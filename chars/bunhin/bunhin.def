; Bù Nhìn - nhân vật làm bao cát cho LAB (phòng luyện tập)
; Không có đòn đánh. Hành vi (đứng/ngồi/nhảy/đỡ đòn...) chỉnh trong menu tạm dừng của Training.
; Hình: model test màu rơm (sinh bằng tools/gen_model.py ... --no-moves).

[Info]
name = "Bu Nhin"
displayname = "Bu Nhin"   ; font thanh máu không có dấu tiếng Việt
versiondate = 11,22,2026
mugenversion = 1.0
author = "MugenFake"
pal.defaults = 1
localcoord = 640,360

[Files]
cmd      = bunhin.cmd
cns      = bunhin.cns
st       = bunhin.cns
stcommon = common1.cns
sprite   = bunhin.sff
anim     = bunhin.air
sound    = bunhin.snd

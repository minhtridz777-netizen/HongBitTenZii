; Nakroth - file định nghĩa nhân vật
; Sát thủ song đao, lướt liên tục, chém nhanh, máu mỏng.
; Thiết kế: designs/NAKROTH_DESIGN.md
; HÌNH TẠM: sprite + âm thanh mượn của Kung Fu Man (nakroth.sff / nakroth.snd là bản copy).

[Info]
name = "Nakroth"
displayname = "Nakroth"
versiondate = 11,22,2026
mugenversion = 1.0
author = "MugenFake"
pal.defaults = 1,2,3,4
localcoord = 320,240

[Files]
cmd      = nakroth.cmd      ; Lệnh + bảng chuyển chiêu (State -1)
cns      = nakroth.cns      ; Chỉ số
st       = nakroth.cns      ; State
stcommon = common1.cns      ; State chung của engine (data/)
sprite   = nakroth.sff
anim     = nakroth.air
sound    = nakroth.snd
movelist = movelist.dat

[Palette Keymap]
x = 1
y = 2
z = 3
a = 4
b = 5
c = 6

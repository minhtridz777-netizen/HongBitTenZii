ctrl = 0
anim = 170
velset = 0,0

[State 170, Bat tu]
type = NotHitBy
trigger1 = 1
value = SCA
time = 1

[Statedef 180]
type = S

[State 180, Chon dang thang]
type = ChangeState
trigger1 = Time = 0
value = 181

[Statedef 181]
type = S
ctrl = 0
anim = 181
velset = 0,0

[State 181, Bat tu]
type = NotHitBy
trigger1 = 1
value = SCA
time = 1

; Xuất hiện đầu trận (state 190 của engine chuyển sang đây)

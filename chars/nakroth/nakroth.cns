; ============================================================================
; NAKROTH - chỉ số + state (.cns) - theo thiết kế v2
; Thiết kế: designs/NAKROTH_DESIGN.md (nguồn chuẩn). Bộ chiêu bám theo Nakroth Liên Quân:
;   Nội tại Thẩm Phán Oai Nghiêm | U Bồi Thẩm Đoàn | S+U Nguồn Cơn Rắc Rối | I Gươm Hành Quyết
; HÌNH TẠM: sprite KFM (chỉ động tác đấm/chưởng) + vệt chém đỏ tự vẽ (sprite 8000-8099).
;
; ---------------- BẢNG BIẾN ----------------
; var(0)  - [U] số tick còn lại của cửa sổ U lần 2 (301 = 5 giây, giữ đầy khi đang ở U lần 1)
; var(1)  - [S+U] số tick còn cường hóa đòn J kế tiếp (180 tick tính từ lúc tiếp đất)
; var(2)  - [Nội tại] số tick còn tăng tốc đánh J (150 tick)
; var(3)  - [.cmd] = 1 khi được phép hủy sang chiêu U / tuyệt chiêu (tính lại mỗi tick)
; var(4)  - [J trên không] số nhát J trên không nối liên tiếp (reset khi chạm đất)
; var(5)  - [U] hồi chiêu Bồi Thẩm Đoàn (120 tick, bắt đầu sau lần 2 hoặc khi hết cửa sổ)
; var(6)  - [S+U] hồi chiêu Nguồn Cơn Rắc Rối (180 tick)
; var(7)  - [Nội tại] số đòn J đã trúng (0-3). Đòn J kế khi var(7) = 3 là đòn thứ 4 -> hất tung
; var(8)  - [Nội tại] đếm ngược 120 tick không đánh trúng J -> reset var(7)
; var(10) - [S+I] (để dành)
; var(11) - [Nội tại] = 1 nếu đòn J đang ra là đòn thứ 4 (đặt lúc vào state)
;
; ---------------- VỊ TRÍ CHIÊU ----------------
; 200 J1 | 210 J2 | 220 J3 | 230 J4 | 240 W+J | 250 J cường hóa (chém quét)
; 400 S+J | 600 J trên không | 700 lướt tới | 705 lướt lùi
; 1000 U lần 1 | 1010 U lần 2 tới | 1015 U lần 2 lùi | 1020 / 1025 U lần 2 trên không tới / lùi
; 1100 S+U | 1200 W+U (lần 1 chéo lên) | 1300 U trên không (lần 1 chéo xuống) | 1305 tiếp đất
; 3000 I Gươm Hành Quyết (siêu giáp) | 3090 dự phòng siêu giáp
; 4000-4030 S+I Phán Quyết Cuối Cùng (4 bước)
; State -2: nội tại, đếm giờ, hồi chiêu, tắt nhảy bằng W, reset giảm sát thương
; ============================================================================

[Data]
life = 850                ; máu mỏng (chuẩn 1000)
attack = 110
defence = 90
fall.defence_up = 50
liedown.time = 60
airjuggle = 15
sparkno = 2
guard.sparkno = 40
KO.echo = 0
volume = 0
IntPersistIndex = 60
FloatPersistIndex = 40

[Size]
xscale = 1
yscale = 1
ground.back = 15
ground.front = 16
air.back = 12
air.front = 12
height = 60
attack.dist = 160
proj.attack.dist = 90
proj.doscale = 0
head.pos = -5, -90
mid.pos = -5, -60
shadowoffset = 0
draw.offset = 0,0

[Velocity]
walk.fwd  = 3.1           ; nhanh hơn KFM ~30% (KFM 2.4)
walk.back = -2.9          ; (KFM -2.2)
run.fwd  = 4.6, 0         ; không dùng (lướt là state 700)
run.back = -4.5,-3.8
jump.neu = 0,-8.4
jump.back = -2.8
jump.fwd = 2.8
runjump.back = -2.55,-8.1
runjump.fwd = 4,-8.1
airjump.neu = 0,-8.1
airjump.back = -2.55
airjump.fwd = 2.5
air.gethit.groundrecover = -.15,-3.5
air.gethit.airrecover.mul = .5,.2
air.gethit.airrecover.add = 0,-4.5
air.gethit.airrecover.back = -1
air.gethit.airrecover.fwd = 0
air.gethit.airrecover.up = -2
air.gethit.airrecover.down = 1.5

[Movement]
airjump.num = 0           ; không nhảy kép
airjump.height = 35
yaccel = .44
stand.friction = .85
crouch.friction = .82
stand.friction.threshold = 2
crouch.friction.threshold = .05
air.gethit.groundlevel = 25
air.gethit.groundrecover.ground.threshold = -20
air.gethit.groundrecover.groundlevel = 10
air.gethit.airrecover.threshold = -1
air.gethit.airrecover.yaccel = .35
air.gethit.trip.groundlevel = 15
down.bounce.offset = 0, 20
down.bounce.yaccel = .4
down.bounce.groundlevel = 12
down.friction.threshold = .05

[Quotes]
victory1 = "Phan quyet da duoc dua ra."
victory2 = "Qua cham."

; ============================================================================
; STATE HỆ THỐNG: thua, thắng, xuất hiện
; ============================================================================
[Statedef 170]
type = S
ctrl = 0
anim = 170
velset = 0,0

[State 170, Bat tu]
type = NotHitBy
trigger1 = 1
value = SCA
time = 1

[Statedef 180]
type = S

[State 180, Chon dang thang]
type = ChangeState
trigger1 = Time = 0
value = 181

[Statedef 181]
type = S
ctrl = 0
anim = 181
velset = 0,0

[State 181, Bat tu]
type = NotHitBy
trigger1 = 1
value = SCA
time = 1

; Xuất hiện đầu trận (state 190 của engine chuyển sang đây)
[Statedef 191]
type = S
ctrl = 0
anim = 190
velset = 0,0

[State 191, Giu anim khi PreIntro]
type = ChangeAnim
trigger1 = RoundState = 0
value = 190

[State 191, Intro]
type = AssertSpecial
trigger1 = 1
flag = Intro

[State 191, Xong]
type = ChangeState
trigger1 = AnimTime = 0
value = 0


; ============================================================================
; ĐÁNH THƯỜNG (200-699) - toàn bộ là chém song đao
; Anim nhanh 280-284 / 480 / 680 khi đang tăng tốc (var(2) > 0).
; ============================================================================
;---------------------------------------------------------------------------
; J1 - chém ngang đao phải | 25 sát thương, ra đòn 3 tick
; Nội tại: var(11) = 1 nếu đây là đòn J thứ 4 -> dùng HitDef hất tung.

; ============================================================================
; STATE -2: chạy mỗi tick, kể cả khi bị đánh
; ============================================================================
[Statedef -2]

; Phím nhảy: tắt nhảy bằng W (Up). Nhảy chỉ bằng K (xem nakroth.cmd).
[State -2, Tat nhay bang W]
type = AssertSpecial
trigger1 = 1
flag = NoJump
flag2 = NoAirJump

; Siêu giáp chỉ giảm sát thương trong Gươm Hành Quyết -> ngoài state 3000 trả về 1
[State -2, Reset giam sat thuong]
type = DefenceMulSet
trigger1 = stateno != 3000
value = 1
multype = 0
onhit = 0
ignorehitpause = 1

; --- Bồi Thẩm Đoàn: hết cửa sổ lần 2 mà không dùng -> bắt đầu hồi chiêu ---
[State -2, Het cua so U]
type = VarSet
trigger1 = var(0) = 1
trigger1 = stateno != 1000 && stateno != 1200 && stateno != 1300
var(5) = 121

; --- Đếm giờ ---
[State -2, Dem cua so U]
type = VarAdd
trigger1 = var(0) > 0
var(0) = -1

[State -2, Dem cuong hoa J]
type = VarAdd
trigger1 = var(1) > 0
var(1) = -1

[State -2, Dem tang toc]
type = VarAdd
trigger1 = var(2) > 0
var(2) = -1

[State -2, Dem hoi chieu U]
type = VarAdd
trigger1 = var(5) > 0
var(5) = -1

[State -2, Dem hoi chieu S+U]
type = VarAdd
trigger1 = var(6) > 0
var(6) = -1

[State -2, Reset J tren khong]
type = VarSet
trigger1 = statetype != A
var(4) = 0

; --- Nội tại #1: đếm đòn J trúng, đòn thứ 4 hất tung ---
[State -2, Dem don J trung]
type = VarSet
trigger1 = MoveHit = 1
trigger1 = (stateno = [200,299]) || (stateno = [400,499]) || (stateno = [600,699])
var(7) = ifelse(var(11) = 1, 0, var(7) + 1)

[State -2, Giu bo dem]
type = VarSet
trigger1 = MoveHit = 1
trigger1 = (stateno = [200,299]) || (stateno = [400,499]) || (stateno = [600,699])
var(8) = 120

[State -2, Het gio bo dem]
type = VarSet
trigger1 = var(8) = 1
var(7) = 0

[State -2, Dem gio bo dem]
type = VarAdd
trigger1 = var(8) > 0
var(8) = -1

; Đòn kế tiếp là đòn thứ 4 -> đao lóe đỏ
[State -2, Loe dao]
type = Explod
trigger1 = var(7) >= 3 && (GameTime % 20) = 0
anim = 8050
pos = 22, -64
postype = p1
facing = 1
bindtime = 8
removetime = -2
sprpriority = 5
ownpal = 1
trans = add

; --- Nội tại #2: chiêu U bất kỳ trúng -> 150 tick đánh J nhanh (S+U tự kích trong state 1100) ---
[State -2, Noi tai tang toc]
type = VarSet
trigger1 = (stateno = [1000,1399]) && MoveHit = 1
var(2) = 150

; --- Hiệu ứng báo trạng thái ---
; Đang cường hóa J (S+U): nháy đỏ
[State -2, Bao cuong hoa]
type = PalFX
trigger1 = var(1) > 0 && (GameTime % 12) < 6
time = 1
add = 110, 0, 0
mul = 256, 190, 190

; Đang tăng tốc (nội tại): ánh bạc nhẹ
[State -2, Bao tang toc]
type = PalFX
trigger1 = var(2) > 0 && var(1) <= 0 && (GameTime % 16) < 8
time = 1
add = 40, 40, 55

; ============================================================================
; STATE -3
; ============================================================================
[Statedef -3]

[State -3, Am tiep dat]
type = PlaySnd
triggerall = Time = 1
trigger1 = stateno = 52
trigger2 = stateno = 106
value = 40, 0

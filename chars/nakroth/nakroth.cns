type    = S
movetype= A
physics = S
juggle  = 1
ctrl    = 0
poweradd = 15
sprpriority = 2
velset  = 0,0

[State 200, Anim]
type = ChangeAnim
trigger1 = Time = 0
value = ifelse(var(2) > 0, 280, 200)

[State 200, Don thu 4?]
type = VarSet
trigger1 = Time = 0
var(11) = ifelse(var(7) >= 3, 1, 0)

[State 200, Tien]

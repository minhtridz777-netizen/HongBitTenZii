; ============================================================================
; TUYỆT CHIÊU CẤP 1 (3000-3999) - phím I, 1000 power
; ============================================================================
; I - Gươm Hành Quyết: 6 nhát chém liên tục + nhát cuối hất văng (~200)
; Siêu giáp: BẢN ĐẦU TẠM DÙNG BẤT TỬ toàn chiêu (theo phương án dự phòng
;            trong bản thiết kế). TODO: làm siêu giáp thật (giảm 50% sát thương).
[Statedef 3000]
type    = S
movetype= A
physics = S
juggle  = 2
velset  = 0,0
ctrl    = 0
anim    = 3000
sprpriority = 2

[State 3000, Super pause]
type = SuperPause
trigger1 = Time = 0
time = 30
anim = 100
sound = 20, 0
pos = 25, -57
poweradd = -1000

[State 3000, Bat tu (tam thay sieu giap)]
type = NotHitBy
trigger1 = 1
value = SCA
time = 1

[State 3000, Bong]
type = AfterImage
trigger1 = Time = 0
time = 80
length = 8
palbright = 80, 0, 0
trans = add

[State 3000, Tien moi nhat]
type = PosAdd
trigger1 = AnimElem = 6
trigger2 = AnimElem = 9
trigger3 = AnimElem = 12
trigger4 = AnimElem = 15
trigger5 = AnimElem = 18
trigger6 = AnimElem = 21
x = 5

[State 3000, Am thanh]
type = PlaySnd
trigger1 = AnimElem = 6
trigger2 = AnimElem = 12
trigger3 = AnimElem = 18
trigger4 = AnimElem = 23
value = 0, 1

[State 3000, 6 nhat chem]
type = HitDef
trigger1 = AnimElem = 6
trigger2 = AnimElem = 9
trigger3 = AnimElem = 12
trigger4 = AnimElem = 15
trigger5 = AnimElem = 18
trigger6 = AnimElem = 21
attr = S, HA
damage = 22, 2
getpower = 0
animtype = Medium
guardflag = MA
hitflag = MAF
priority = 6, Hit
pausetime = 3, 5
sparkxy = -10, -65
hitsound = 5, 1
guardsound = 6, 0
ground.type = High
ground.slidetime = 6
ground.hittime = 25
ground.velocity = -1.5
air.velocity = -1, -2.2
air.hittime = 25

[State 3000, Nhat cuoi hat van]
type = HitDef
trigger1 = AnimElem = 24
attr = S, HA
damage = 70, 4
getpower = 0
animtype = Hard
guardflag = MA
hitflag = MAF
priority = 6, Hit
pausetime = 12, 14
sparkxy = -10, -65
hitsound = 5, 4
guardsound = 6, 0
ground.type = High
ground.slidetime = 20
ground.hittime = 30
ground.velocity = -6, -5
air.velocity = -6, -5
fall = 1
fall.recover = 0
envshake.time = 15
envshake.ampl = 4

[State 3000, Het]
type = ChangeState
trigger1 = AnimTime = 0
value = 0
ctrl = 1

; ============================================================================
; TUYỆT CHIÊU CẤP 3 (4000-4999) - phím S + I, 3000 power
; ============================================================================
; S + I - Phán Quyết Cuối Cùng (~380):
;   4000: màn hình tối, lướt chém nhát đầu (40). Trượt -> hết chiêu.
;   4010: trúng -> lướt xuyên qua lại 5 lần (5 x 48).
;   4020: nhát chém lớn kết thúc (100), đối thủ ngã.
[Statedef 4000]
type    = S
movetype= A
physics = S
juggle  = 2
velset  = 0,0
ctrl    = 0
anim    = 4000
sprpriority = 2

[State 4000, Reset dem]
type = VarSet
trigger1 = Time = 0
var(10) = 0

[State 4000, Super pause]
type = SuperPause
trigger1 = Time = 0
time = 45
anim = 100
sound = 20, 0
pos = 25, -57
poweradd = -3000

[State 4000, Man hinh toi]
type = BGPalFX
trigger1 = 1
time = 2
mul = 70, 60, 60

[State 4000, Bat tu]
type = NotHitBy
trigger1 = 1
value = SCA
time = 1

[State 4000, Xuyen qua]
type = PlayerPush
trigger1 = Time >= 3
value = 0

[State 4000, Luot]
type = VelSet
trigger1 = Time = [3,20]
x = 11

[State 4000, Bong]
type = AfterImage
trigger1 = Time = 0
time = 30
length = 8
palbright = 100, 0, 0
trans = add

[State 4000, Nhat dau]
type = HitDef
trigger1 = AnimElem = 3
attr = S, HA
damage = 40, 3
getpower = 0
animtype = Medium
guardflag = MA
hitflag = MAF
priority = 6, Hit
pausetime = 6, 10
sparkxy = -10, -60
hitsound = 5, 2
guardsound = 6, 0
ground.type = High
ground.slidetime = 0
ground.hittime = 40
ground.velocity = 0
air.velocity = 0, -2
air.hittime = 40

[State 4000, Trung -> lien hoan]
type = ChangeState
trigger1 = MoveHit
value = 4010

[State 4000, Truot -> het]
type = ChangeState
trigger1 = Time >= 26
value = 0
ctrl = 1

;---------------------------------------------------------------------------
; Lướt xuyên qua lại: mỗi vòng 16 tick (quay mặt -> lướt -> chém -> dừng)
[Statedef 4010]
type    = S
movetype= A
physics = N
ctrl    = 0
anim    = 4010
sprpriority = 2

[State 4010, Man hinh toi]
type = BGPalFX
trigger1 = 1
time = 2
mul = 70, 60, 60

[State 4010, Bat tu]
type = NotHitBy
trigger1 = 1
value = SCA
time = 1

[State 4010, Xuyen qua]
type = PlayerPush
trigger1 = 1
value = 0

[State 4010, Du 5 lan -> ket thuc]
type = ChangeState
trigger1 = (Time % 16) = 0 && var(10) >= 5
value = 4020

[State 4010, Quay mat]
type = Turn
trigger1 = (Time % 16) = 0 && P2Dist X < 0

[State 4010, Dem]
type = VarAdd
trigger1 = (Time % 16) = 0
var(10) = 1

[State 4010, Lao]
type = VelSet
trigger1 = (Time % 16) = 0
x = 10
y = 0

[State 4010, Dung]
type = VelSet
trigger1 = (Time % 16) = 11
x = 0
y = 0

[State 4010, Bong]
type = AfterImage
trigger1 = Time = 0
time = 100
length = 8
palbright = 100, 0, 0
trans = add

[State 4010, Am thanh]
type = PlaySnd
trigger1 = (Time % 16) = 1
value = 0, 1

[State 4010, Vet chem]
type = HitDef
trigger1 = (Time % 16) = 1
attr = S, HA
damage = 48, 3
getpower = 0
animtype = Medium
guardflag = MA
hitflag = MAF
priority = 6, Hit
pausetime = 3, 6
sparkxy = -10, -60
hitsound = 5, 2
guardsound = 6, 0
ground.type = High
ground.slidetime = 0
ground.hittime = 30
ground.velocity = 0
air.velocity = 0, -2.5
air.hittime = 30

;---------------------------------------------------------------------------
; Nhát chém lớn kết thúc
[Statedef 4020]
type    = S
movetype= A
physics = S
ctrl    = 0
velset  = 0,0
anim    = 4020
sprpriority = 2

[State 4020, Quay mat]
type = Turn
trigger1 = Time = 0 && P2Dist X < 0

[State 4020, Man hinh toi]
type = BGPalFX
trigger1 = AnimElemTime(6) < 0
time = 2
mul = 70, 60, 60

[State 4020, Bat tu]
type = NotHitBy
trigger1 = 1
value = SCA
time = 1

[State 4020, Am thanh]
type = PlaySnd
trigger1 = AnimElem = 5
value = 0, 3

[State 4020, Nhat ket thuc]
type = HitDef
trigger1 = AnimElem = 6
attr = S, HA
damage = 100, 5
getpower = 0
animtype = Hard
guardflag = MA
hitflag = MAF
priority = 7, Hit
pausetime = 15, 18
sparkxy = -10, -65
hitsound = 5, 4
guardsound = 6, 0
ground.type = High
ground.slidetime = 20
ground.hittime = 30
ground.velocity = -7, -5
air.velocity = -7, -5
fall = 1
fall.recover = 0
envshake.time = 20
envshake.ampl = 6

[State 4020, Het]
type = ChangeState
trigger1 = AnimTime = 0
value = 0
ctrl = 1

; ============================================================================
; STATE -2: chạy mỗi tick, kể cả khi bị đánh
; ============================================================================
[Statedef -2]

; Phím nhảy: tắt nhảy bằng W (Up). Nhảy chỉ bằng K (xem nakroth.cmd).
[State -2, Tat nhay bang W]
type = AssertSpecial
trigger1 = 1
flag = NoJump
flag2 = NoAirJump

; --- Đếm giờ ---
[State -2, Dem U lan 2]
type = VarAdd
trigger1 = var(0) > 0
var(0) = -1

[State -2, Dem cuong hoa J]
type = VarAdd
trigger1 = var(1) > 0
var(1) = -1

[State -2, Dem noi tai]
type = VarAdd
trigger1 = var(2) > 0
var(2) = -1

[State -2, Reset J tren khong]
type = VarSet
trigger1 = statetype != A
var(4) = 0

; --- Nội tại Thẩm Phán #2: chiêu U bất kỳ trúng -> 150 tick đánh J nhanh ---
[State -2, Noi tai Tham Phan]
type = VarSet
trigger1 = (stateno = [1000,1399]) && MoveHit = 1
var(2) = 150

; --- Hiệu ứng báo trạng thái ---
; Đang cường hóa J (S+U): nháy đỏ
[State -2, Bao cuong hoa]
type = PalFX
trigger1 = var(1) > 0 && (GameTime % 12) < 6
time = 1
add = 110, 0, 0
mul = 256, 190, 190

; Đang tăng tốc (nội tại): ánh bạc nhẹ
[State -2, Bao noi tai]
type = PalFX
trigger1 = var(2) > 0 && var(1) <= 0 && (GameTime % 16) < 8
time = 1
add = 40, 40, 55

; ============================================================================
; STATE -3
; ============================================================================
[Statedef -3]

[State -3, Am tiep dat]
type = PlaySnd
triggerall = Time = 1
trigger1 = stateno = 52
trigger2 = stateno = 106
value = 40, 0

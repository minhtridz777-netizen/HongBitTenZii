; Cơ chế chung (đỡ, thể lực, lướt, nhảy đôi, thoát combo). Nhân vật trong chars/<tên>/ dùng:
;   st2 = ../../shared/char_template/khung.cns
st2      = khung.cns
stcommon = common1.cns
sprite   = mau.sff
anim     = mau.air
